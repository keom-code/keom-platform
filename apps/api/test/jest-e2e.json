{
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "setupFiles": [
    "<rootDir>/setup-env.ts"
  ],
  "moduleNameMapper": {
    "^@keom/contracts$": "<rootDir>/../../../packages/contracts/src/index.ts"
  }
}
