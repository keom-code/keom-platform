# --- apps/api ---

# Local PostgreSQL (see docker-compose.yml). Matches the docker-compose defaults below.
DATABASE_URL="postgresql://keom:keom@localhost:5433/keom_api?schema=public"

PORT=3001

# Meta webhook verification handshake (GET /webhooks/whatsapp?hub.verify_token=...).
# Not used by the local fixture-POST testing flow; only relevant once this endpoint is
# actually registered as a callback URL with Meta. Production value must be a real secret.
WHATSAPP_VERIFY_TOKEN=dev-verify-token

# M2B: LLM Commercial Interpretation Layer. Provider is env-driven so business logic never
# hardcodes it: "openai" (default) or "jev" (experimental, TypeSafe AI). Not required for
# M1/M2A; only POST /dev/interpretation/evaluate needs these, and only the selected
# provider's variables are required. Placeholders only — never a real key.
LLM_PROVIDER=openai
LLM_TIMEOUT_MS=10000

# OpenAI. Pick a cheap structured-extraction model. OPENAI_MODEL replaces the legacy
# LLM_MODEL (still read as a fallback). Set OPENAI_REASONING_EFFORT only for reasoning
# models such as gpt-5.6-luna (e.g. "none"); leave it empty otherwise.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REASONING_EFFORT=

# Jev (TypeSafe AI) — experimental, used by LLM_PROVIDER=jev and the offline evaluation.
# JEV_MODEL must be a pinned version, not the jev-latest/jev-preview aliases.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0

# M3: Business Knowledge / RAG. Not required for M1/M2A/M2B; only /dev/knowledge/* needs
# these. OPENAI_API_KEY above is reused. The model's output must be 1536-dimensional (the
# pgvector column size) — changing model/dimension means a migration + re-embedding, see
# apps/api/README.md M3. Grounded suggestions reuse OPENAI_MODEL.
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_TIMEOUT_MS=10000      # optional; falls back to LLM_TIMEOUT_MS
# KNOWLEDGE_TOP_K=5               # optional; chunks returned per search (1-20)
# KNOWLEDGE_MIN_SIMILARITY=0.35   # optional; cosine similarity cutoff (0-1), calibrated for text-embedding-3-small
