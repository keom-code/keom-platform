generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Provider {
  WHATSAPP

  @@map("provider")
}

enum MessageDirection {
  INBOUND
  OUTBOUND

  @@map("message_direction")
}

/// M2A: where an Opportunity is commercially, per docs/ARCHITECTURE.md-style deterministic
/// rules (see apps/api/README.md M2A section). Deliberately has no terminal state
/// (WON/LOST/RECOVERED) yet — a NO_LONGER_INTERESTED signal deactivates the Opportunity
/// (see Opportunity.isActive) instead of moving it to a terminal state. A later milestone
/// should introduce real lifecycle states once outcomes are tracked.
enum OpportunityState {
  NEW
  ENGAGED
  HIGH_INTENT
  AT_RISK

  @@map("opportunity_state")
}

/// Shared LOW/MEDIUM/HIGH scale reused for RiskLevel, Priority and InterestLevel.
enum RiskLevel {
  LOW
  MEDIUM
  HIGH

  @@map("risk_level")
}

enum Priority {
  LOW
  MEDIUM
  HIGH

  @@map("priority")
}

enum InterestLevel {
  LOW
  MEDIUM
  HIGH

  @@map("interest_level")
}

/// Deterministic, structured commercial signals fed into the Opportunity engine (M2A).
/// Supplied as input for now (fixtures/dev endpoint/tests) — inferring these from
/// Message.text via an LLM is M2B, not M2A.
enum SignalType {
  PRICING_REQUESTED
  AVAILABILITY_REQUESTED
  BOOKING_INTENT
  PURCHASE_INTENT
  QUOTE_REQUESTED
  PAYMENT_QUESTION
  FOLLOW_UP_REQUESTED
  OBJECTION
  NO_LONGER_INTERESTED

  @@map("signal_type")
}

/// M3: how a KnowledgeDocument's content was supplied. Content kind (FAQ, policy, price
/// list...) is deliberately NOT modelled here — that goes in free-form `metadata`.
enum KnowledgeSourceType {
  TEXT
  MARKDOWN

  @@map("knowledge_source_type")
}

/// Phase 11: who is calling the authenticated /v1 API. Matches @keom/contracts Role.
enum UserRole {
  SELLER
  ADMIN

  @@map("user_role")
}

/// Phase 11: seller-facing alert lifecycle, matching @keom/contracts AlertStatus.
/// Forward-only for now (PENDING -> ACKNOWLEDGED -> COMPLETED); reopening rules belong to M5.
enum AlertStatus {
  PENDING
  ACKNOWLEDGED
  COMPLETED

  @@map("alert_status")
}

enum NextBestAction {
  RESPOND
  SEND_INFORMATION
  ASK_QUESTION
  OFFER_APPOINTMENT
  FOLLOW_UP
  WAIT
  ESCALATE_TO_HUMAN

  @@map("next_best_action")
}

model Company {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  integrations  Integration[]
  customers     Customer[]
  conversations Conversation[]
  messages      Message[]
  rawEvents     RawEvent[]
  opportunities Opportunity[]
  knowledgeDocuments KnowledgeDocument[]
  users         User[]

  @@map("company")
}

model Integration {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  company       Company  @relation(fields: [companyId], references: [id])
  provider      Provider
  wabaId        String?  @map("waba_id")
  phoneNumberId String   @unique @map("phone_number_id")
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("integration")
}

/// Original inbound provider payload, stored verbatim for debugging/auditing/reprocessing.
/// companyId is nullable: an event from an unrecognized phoneNumberId is still stored for
/// investigation, just without tenant attribution.
model RawEvent {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String?   @map("company_id") @db.Uuid
  company         Company?  @relation(fields: [companyId], references: [id])
  provider        Provider
  eventType       String    @map("event_type")
  externalEventId String?   @map("external_event_id")
  payload         Json
  status          String    @default("RECEIVED")
  receivedAt      DateTime  @default(now()) @map("received_at")
  processedAt     DateTime? @map("processed_at")

  @@index([companyId])
  @@map("raw_event")
}

model Customer {
  id            String         @id @default(uuid()) @db.Uuid
  companyId     String         @map("company_id") @db.Uuid
  company       Company        @relation(fields: [companyId], references: [id])
  externalId    String         @map("external_id")
  name          String?
  phone         String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  conversations Conversation[]
  opportunities Opportunity[]

  @@unique([companyId, externalId])
  @@map("customer")
}

model Conversation {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  company    Company   @relation(fields: [companyId], references: [id])
  customerId String    @map("customer_id") @db.Uuid
  customer   Customer  @relation(fields: [customerId], references: [id])
  channel    Provider
  externalId String?   @map("external_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  messages   Message[]
  opportunities Opportunity[]

  @@unique([companyId, customerId, channel])
  @@map("conversation")
}

/// externalMessageId + companyId is the idempotency key: Meta may redeliver the same
/// webhook, and this unique constraint is what turns a duplicate POST into a no-op
/// instead of a duplicate row.
model Message {
  id                String           @id @default(uuid()) @db.Uuid
  companyId         String           @map("company_id") @db.Uuid
  company           Company          @relation(fields: [companyId], references: [id])
  conversationId    String           @map("conversation_id") @db.Uuid
  conversation      Conversation     @relation(fields: [conversationId], references: [id])
  externalMessageId String           @map("external_message_id")
  direction         MessageDirection
  type              String
  text              String?
  sentAt            DateTime         @map("sent_at")
  createdAt         DateTime         @default(now()) @map("created_at")

  @@unique([companyId, externalMessageId])
  @@map("message")
}

/// M2A deterministic Opportunity Engine. No unique constraint tying this to one
/// Conversation on purpose: multiple opportunities (sequential or, later, concurrent)
/// may exist per conversation. `isActive` is the MVP mechanism for "the one currently
/// relevant opportunity" — OpportunitiesService resolves the most recently updated
/// active row per conversationId; no intent/topic matching yet. See apps/api/README.md.
model Opportunity {
  id              String            @id @default(uuid()) @db.Uuid
  companyId       String            @map("company_id") @db.Uuid
  company         Company           @relation(fields: [companyId], references: [id])
  customerId      String            @map("customer_id") @db.Uuid
  customer        Customer          @relation(fields: [customerId], references: [id])
  conversationId  String            @map("conversation_id") @db.Uuid
  conversation    Conversation      @relation(fields: [conversationId], references: [id])
  state           OpportunityState  @default(NEW)
  priority        Priority          @default(LOW)
  risk            RiskLevel         @default(LOW)
  interestLevel   InterestLevel?    @map("interest_level")
  score           Int               @default(0)
  isActive        Boolean           @default(true) @map("is_active")
  /// M4: the signal set of the latest evidence-bearing evaluation (M2A dev endpoint or
  /// M2B), so a timer-triggered re-evaluation can rerun M2A on the same evidence with
  /// fresh timestamps. OpportunitySignal rows stay the append-only history.
  currentSignals  SignalType[]      @default([]) @map("current_signals")
  lastEvaluatedAt DateTime?         @map("last_evaluated_at")
  /// Phase 11: the seller's handling of this opportunity as an alert. Independent of M2A's
  /// commercial state — re-evaluation never changes it.
  alertStatus     AlertStatus       @default(PENDING) @map("alert_status")
  acknowledgedAt  DateTime?         @map("acknowledged_at")
  completedAt     DateTime?         @map("completed_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  signals                OpportunitySignal[]
  stateHistory            OpportunityStateHistory[]
  actionRecommendations   ActionRecommendation[]

  @@index([companyId])
  @@index([conversationId, isActive])
  @@map("opportunity")
}

model OpportunitySignal {
  id              String       @id @default(uuid()) @db.Uuid
  opportunityId   String       @map("opportunity_id") @db.Uuid
  opportunity     Opportunity  @relation(fields: [opportunityId], references: [id])
  type            SignalType
  confidence      Float?
  sourceMessageId String?      @map("source_message_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at")

  @@index([opportunityId])
  @@map("opportunity_signal")
}

/// One row per state transition only — reevaluating to the same state does not insert
/// a row (see OpportunitiesService).
model OpportunityStateHistory {
  id             String            @id @default(uuid()) @db.Uuid
  opportunityId  String            @map("opportunity_id") @db.Uuid
  opportunity    Opportunity       @relation(fields: [opportunityId], references: [id])
  previousState  OpportunityState? @map("previous_state")
  newState       OpportunityState  @map("new_state")
  reason         String?
  createdAt      DateTime          @default(now()) @map("created_at")

  @@index([opportunityId])
  @@map("opportunity_state_history")
}

/// One row per distinct recommended action — reevaluating to the same action does not
/// insert a row (see OpportunitiesService).
model ActionRecommendation {
  id            String         @id @default(uuid()) @db.Uuid
  opportunityId String         @map("opportunity_id") @db.Uuid
  opportunity   Opportunity    @relation(fields: [opportunityId], references: [id])
  action        NextBestAction
  reason        String
  priority      Priority
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([opportunityId])
  @@map("action_recommendation")
}

/// M3: one piece of static/semi-static business knowledge (FAQ, price list, policy...) for
/// one Company. Industry-agnostic on purpose: no domain columns, anything business-specific
/// goes in free-form `metadata`. `content` is the normalized text and the source of truth
/// for re-chunking/re-embedding. No processing status: KnowledgeDocumentsService embeds
/// every chunk before writing anything, then writes document + chunks in one transaction,
/// so a partially indexed document cannot exist. `[companyId, contentHash]` makes an
/// accidental duplicate POST return the existing document instead of re-indexing it.
model KnowledgeDocument {
  id          String              @id @default(uuid()) @db.Uuid
  companyId   String              @map("company_id") @db.Uuid
  company     Company             @relation(fields: [companyId], references: [id])
  title       String
  sourceType  KnowledgeSourceType @default(TEXT) @map("source_type")
  sourceName  String?             @map("source_name")
  content     String
  contentHash String              @map("content_hash")
  metadata    Json                @default("{}")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  chunks      KnowledgeChunk[]

  @@unique([id, companyId])
  @@unique([companyId, contentHash])
  @@index([companyId])
  @@map("knowledge_document")
}

/// M3: one embedded chunk of a KnowledgeDocument. The composite FK (documentId, companyId)
/// makes a chunk whose companyId differs from its document's impossible at the DB level,
/// and cascades deletes so no stale vectors outlive their document. `embedding` is a
/// pgvector column Prisma can't read/write natively — inserts and similarity search go
/// through raw SQL in src/knowledge/knowledge-chunk.repository.ts only. The dimension
/// (1536) is fixed by text-embedding-3-small; changing model/dimension means a migration
/// plus re-embedding every document (see apps/api/README.md M3). `embeddingModel` keeps
/// vectors from different models from ever being compared.
model KnowledgeChunk {
  id             String                      @id @default(uuid()) @db.Uuid
  companyId      String                      @map("company_id") @db.Uuid
  documentId     String                      @map("document_id") @db.Uuid
  document       KnowledgeDocument           @relation(fields: [documentId, companyId], references: [id, companyId], onDelete: Cascade)
  chunkIndex     Int                         @map("chunk_index")
  content        String
  metadata       Json                        @default("{}")
  embedding      Unsupported("vector(1536)")
  embeddingModel String                      @map("embedding_model")
  createdAt      DateTime                    @default(now()) @map("created_at")

  @@unique([documentId, chunkIndex])
  @@index([companyId])
  @@map("knowledge_chunk")
}

/// Phase 11: a person who uses the dashboard. Belongs to exactly one Company — every /v1
/// request is scoped to the companyId inside the caller's token, never to request input.
/// `dni` is the login identifier (unique across KEOM, as in the UI's DNI login); it is never
/// logged nor returned by the API. `passwordHash` is scrypt (src/auth/password.ts), never the
/// password. Created by prisma/seed.ts until a real onboarding flow exists.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  company      Company  @relation(fields: [companyId], references: [id])
  name         String
  role         UserRole
  dni          String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("user")
}
