generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Provider {
  WHATSAPP
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model Company {
  id            String         @id @default(cuid())
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  integrations  Integration[]
  customers     Customer[]
  conversations Conversation[]
  messages      Message[]
  rawEvents     RawEvent[]
}

model Integration {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  provider      Provider
  wabaId        String?
  phoneNumberId String   @unique
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId])
}

/// Original inbound provider payload, stored verbatim for debugging/auditing/reprocessing.
/// companyId is nullable: an event from an unrecognized phoneNumberId is still stored for
/// investigation, just without tenant attribution.
model RawEvent {
  id              String    @id @default(cuid())
  companyId       String?
  company         Company?  @relation(fields: [companyId], references: [id])
  provider        Provider
  eventType       String
  externalEventId String?
  payload         Json
  status          String    @default("RECEIVED")
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?

  @@index([companyId])
}

model Customer {
  id            String         @id @default(cuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id])
  externalId    String
  name          String?
  phone         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]

  @@unique([companyId, externalId])
}

model Conversation {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  channel    Provider
  externalId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  messages   Message[]

  @@unique([companyId, customerId, channel])
}

/// externalMessageId + companyId is the idempotency key: Meta may redeliver the same
/// webhook, and this unique constraint is what turns a duplicate POST into a no-op
/// instead of a duplicate row.
model Message {
  id                String           @id @default(cuid())
  companyId         String
  company           Company          @relation(fields: [companyId], references: [id])
  conversationId    String
  conversation      Conversation     @relation(fields: [conversationId], references: [id])
  externalMessageId String
  direction         MessageDirection
  type              String
  text              String?
  sentAt            DateTime
  createdAt         DateTime         @default(now())

  @@unique([companyId, externalMessageId])
}
