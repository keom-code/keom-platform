# --- apps/web ---

# "mock" (default) reads from packages/mocks fixtures.
# "http" calls apps/api. Server-only: never expose as NEXT_PUBLIC_*.
DATA_SOURCE=mock

# Base URL for apps/api, used only when DATA_SOURCE=http. Server-only.
API_BASE_URL=http://localhost:3001

# Symmetric signing key for the mock-auth session cookie (jose/HS256).
# Server-only. Generate a real secret before any shared/deployed environment.
SESSION_SECRET=replace-with-a-long-random-string
